#### Data Mariia Shestova ####
DB_MariiaShestova = read.csv(file = "C:\\Users\\matte\\OneDrive\\Documenti\\Desktop\\VAIAK\\VAIAK int\\DB_MariShestova.csv") %>%
rename("ID" = "Anketa_Number")
DB_MariiaShestova_Bio = read_excel(path = "C:\\Users\\matte\\OneDrive\\Documenti\\Desktop\\VAIAK\\VAIAK int\\DB_MariiaShestova_Bio.xlsx") %>%
select(
age, sex, ID)
DB_MariiaShestova_full = full_join(
