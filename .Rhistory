rename_with(
~ paste0(
"AI_",
ceiling(seq_along(.x) / 7),
"_",
((seq_along(.x) - 1) %% 7) + 1),
"A_1" : "A_11") %>%
rename_with(
~ paste0("B", seq_along(.x)),
"B_1" : "B_6") %>%
rename(
"Age" = "age",
"Sex"= "sex") %>%
mutate(
Expert = case_when(
Expert == 0 ~ "Lay person",
Expert == 1 ~ "Expert",
TRUE ~ NA_character_)) %>%
mutate(
